{
  "name": "python-path-local",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "desktop"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:learning": "node --experimental-strip-types scripts/build-learning-bundle.mjs",
    "prebuild:offline": "npm run build:learning",
    "build:offline": "node --experimental-strip-types scripts/build-offline-html.mjs",
    "prebuild:pages": "npm run build:offline",
    "build:pages": "node scripts/build-pages.mjs",
    "desktop:dev": "npm run start --workspace @stewie/desktop",
    "desktop:make": "npm run make --workspace @stewie/desktop",
    "desktop:package": "npm run package --workspace @stewie/desktop",
    "desktop:typecheck": "npm run typecheck --workspace @stewie/desktop",
    "prepare:python-runtime": "node scripts/prepare-python-runtime.mjs",
    "test:python": "node scripts/test-python-runtime.mjs",
    "smoke:packaged-python": "node --experimental-strip-types scripts/smoke-packaged-python.mjs",
    "smoke:packaged-renderer": "node scripts/smoke-packaged-renderer.mjs",
    "prepare:pyodide": "node scripts/prepare-pyodide.mjs",
    "postinstall": "npm run prepare:pyodide",
    "predev": "npm run prepare:pyodide",
    "dev": "node scripts/run-local.mjs dev",
    "dev:site": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run build:learning && npm run prepare:pyodide",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "node scripts/run-local.mjs start",
    "start:site": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:all": "npm run prepare:python-runtime && npm run test:python && npm run test && npm run lint -- --max-warnings=0 && npm run desktop:typecheck && npm run build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern public/pyodide"
  },
  "dependencies": {
    "next": "16.2.6",
    "pyodide": "314.0.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
